{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "sahil-azureproject-datafactory"
		},
		"AzureProjectSqlDatabase_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureProjectSqlDatabase'"
		},
		"Azure_project_datalake_service_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Azure_project_datalake_service'"
		},
		"AzureProjectSqlDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sahilazureprojectserver.database.windows.net"
		},
		"AzureProjectSqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sahilazureprojectdb"
		},
		"AzureProjectSqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sahiladmin"
		},
		"Azure_project_datalake_service_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sahilazureprojectstorage.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "sahil-azureproject-datafactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureProjectSqlDatabase_password": {
						"value": "[parameters('AzureProjectSqlDatabase_password')]"
					},
					"Azure_project_datalake_service_accountKey": {
						"value": "[parameters('Azure_project_datalake_service_accountKey')]"
					},
					"AzureProjectSqlDatabase_properties_typeProperties_server": {
						"value": "[parameters('AzureProjectSqlDatabase_properties_typeProperties_server')]"
					},
					"AzureProjectSqlDatabase_properties_typeProperties_database": {
						"value": "[parameters('AzureProjectSqlDatabase_properties_typeProperties_database')]"
					},
					"AzureProjectSqlDatabase_properties_typeProperties_userName": {
						"value": "[parameters('AzureProjectSqlDatabase_properties_typeProperties_userName')]"
					},
					"Azure_project_datalake_service_properties_typeProperties_url": {
						"value": "[parameters('Azure_project_datalake_service_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}